# Explore LLM benchmark — copy to benchmark/.env or repo-root .env
# Never commit real keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Supabase (service role required to call explore_readonly — same as the Edge Function)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Models (optional — defaults shown)
BENCHMARK_OPENAI_MODEL=gpt-4o-mini
BENCHMARK_ANTHROPIC_MODEL=claude-sonnet-4-6
BENCHMARK_GEMINI_MODEL=gemini-3.6-flash
